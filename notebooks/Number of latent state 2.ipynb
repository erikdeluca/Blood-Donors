    "# function to compare the scores of ELBO on multiple models whit different number of states \n",
    "def compare_elbo(obs_data, num_states,  x_pi, x_A, x_em, num_inits=3, n_steps=1200, lr=0.01, verbose=True):\n",
    "    best_models = collections.defaultdict(dict)\n",
    "    best_scores = {\"elbo\": collections.defaultdict(float)}\n",
    "\n",
    "    for K in num_states:\n",
    "        best_elbo = float(\"-inf\")\n",
    "        best_elbo_params = None\n",
    "\n",
    "        for init in range(num_inits):\n",
    "            seed = init\n",
    "            elbo, params = fit_hmm(K, obs_data, x_pi, x_A, x_em, n_steps=n_steps, lr=lr, seed=seed, verbose=verbose)\n",
    "\n",
    "            if verbose:\n",
    "                print(f\"Training VI(K={K}, init={init}) ELBO = {elbo:.2f}\")\n",
    "\n",
    "            # Aggiorna miglior modello secondo ELBO\n",
    "            if elbo > best_elbo:\n",
    "                best_elbo = elbo\n",
    "                best_elbo_params = params\n",
    "\n",
    "        best_models[\"elbo\"][K]     = best_elbo_params\n",
    "        best_scores[\"elbo\"][K]     = best_elbo\n",
    "\n",
    "    return best_models, best_scores\n",
    "\n",
    "best_models, best_scores = compare_elbo(obs_torch, [3, 6], cov_init_torch, cov_tran_torch, cov_emiss_torch, num_inits=3,  n_steps=300, lr=0.05, verbose=True)\n"
   ]
