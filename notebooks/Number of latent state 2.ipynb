    "    ggplot, aes, geom_col, geom_tile, geom_text, position_dodge,\n",
    "    scale_fill_brewer, scale_fill_gradient, theme_bw, theme, element_text,\n",
    "    labs, scale_x_discrete, scale_y_discrete\n",
