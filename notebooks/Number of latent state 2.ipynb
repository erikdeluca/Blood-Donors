    "import collections\n",
    "from pyro.infer import config_enumerate\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "def make_model(K):\n",
    "    #@config_enumerate\n",
    "    def model(obs, x_pi, x_A, x_em):\n",
    "        N, T = obs.shape\n",
    "        C_pi = x_pi.shape[1]  # 2\n",
    "        C_A  = x_A.shape[2] # 8 \n",
    "        C_em = x_em.shape[2] # 9\n",
    "\n",
    "        # Priors\n",
    "        alpha_pi = 0.5 * torch.ones(K)        # <1 → più “spiky”\n",
    "        alpha_A  = torch.full((K, K), 0.5)\n",
    "        alpha_A.fill_diagonal_(6.0)           # forte massa in diagonale\n",
    "        \n",
    "        pi_base = pyro.sample(\"pi_base\", dist.Dirichlet(alpha_pi))             # [K]\n",
    "        A_base  = pyro.sample(\"A_base\",  dist.Dirichlet(alpha_A).to_event(1))  # [K,K,K]\n",
    "        \n",
    "        print(\"A_base_model:\", A_base.shape)        #\n",
    "        \n",
    "        log_pi_base = pi_base.log()\n",
    "        print(\"log_pi_base:\", log_pi_base.shape)  # [K]\n",
    "        log_A_base  = A_base.log()\n",
    "        print(\"log_A_base:\", log_A_base.shape)  # [K,K,K]\n",
    "\n",
    "\n",
    "        # Parametri globali\n",
    "        W_pi  = pyro.param(\"W_pi\", 0.01 * torch.randn(K, C_pi))\n",
    "        W_A   = pyro.param(\"W_A\",  0.01 * torch.randn(K, K, C_A))\n",
    "        beta_em = pyro.param(\"beta_em\", 0.01 * torch.randn(K, C_em + 1))\n",
    "        \n",
    "        with pyro.plate(\"seqs\", N):\n",
    "            # stato iniziale\n",
    "            logits0 = log_pi_base + (x_pi @ W_pi.T)\n",
    "            z_prev = pyro.sample(\"z_0\", dist.Categorical(logits=logits0))\n",
    "                                #infer={\"enumerate\": \"parallel\"})\n",
    "            print(\"z_prev:\", z_prev)  # [N]\n",
    "            log_mu0 = beta_em[z_prev, 0] + (x_em[:, 0, :] * beta_em[z_prev, 1:]).sum(-1)\n",
    "            pyro.sample(\"y_0\", dist.Poisson(log_mu0.exp()), obs=obs[:, 0])\n",
    "\n",
    "             # For t = 1 ... T-1, update state and emit\n",
    "            for t in range(1, T):\n",
    "                x_t = x_A[:, t, :]    \n",
    "                contrib = torch.einsum(\"nc,nkc->nk\", x_t, W_A[z_prev])\n",
    "                print(' log_A_base[z_prev].sum(-1) ',  (log_A_base[z_prev].sum(-1)).shape)\n",
    "\n",
    "                logitsT = log_A_base[z_prev].sum(-1) + contrib    # [N, K]\n",
    "                print('superato')\n",
    "                z_t = pyro.sample(f\"z_{t}\",\n",
    "                                dist.Categorical(logits=logitsT))\n",
    "                                #infer={\"enumerate\": \"parallel\"})\n",
    "\n",
    "                # Emission: state-specific GLM at time t\n",
    "                log_mu_t = beta_em[z_t, 0] + (x_em[:, t, :] * beta_em[z_t, 1:]).sum(-1)\n",
    "                pyro.sample(f\"y_{t}\", dist.Poisson(log_mu_t.exp()), obs=obs[:, t])\n",
    "                z_prev = z_t\n",
    "                print('sono qui')\n",
    "\n",
    "\n",
    "            # # transizioni\n",
    "            # for t in range(1, T):\n",
    "            #     x_t = x_A[:, t, :]\n",
    "                \n",
    "            #     # x_t: [N, C_A]\n",
    "            #     # W_A: [K, K, C_A]\n",
    "            #     contrib = torch.einsum(\"nc,ijk->jik\", x_t, W_A)  # [K, N, K]\n",
    "            #     # log_A_base: [K, K]\n",
    "            #     print(log_A_base.shape)\n",
    "            #     print(contrib.shape)\n",
    "            #     logitsT_full = log_A_base[:, None, :] + contrib  # [K, 1, K] + [K, N, K] -> [K, N, K]\n",
    "            #     logitsT_full = (log_A_base.unsqueeze(0) + contrib).permute(1, 0, 2)  # [K, N, K]\n",
    "            #     # NON indicizzare con z_prev: Pyro gestisce l'enumerazione\n",
    "            #     z_t = pyro.sample(\n",
    "            #         f\"z_{t}\",\n",
    "            #         dist.Categorical(logits=logitsT_full),   # batch [K, N], event K\n",
    "            #         infer={\"enumerate\": \"parallel\"},\n",
    "            #     )\n",
    "\n",
    "            #     # emissioni (rendiamo il broadcasting esplicito)\n",
    "            #     x_em_t = x_em[:, t, :].unsqueeze(0)               # [1, N, C_em]\n",
    "            #     beta_t  = beta_em[z_t]                            # [K, N, C_em+1]\n",
    "            #     log_mu_t = beta_t[..., 0] + (x_em_t * beta_t[..., 1:]).sum(-1)  # [K, N]\n",
    "\n",
    "            #     pyro.sample(f\"y_{t}\", dist.Poisson(log_mu_t.exp()), obs=obs[:, t])  # ok: obs [N]\n",
    "\n",
    "            #     z_prev = z_t\n",
    "    return model\n",
    "# ------------------------------------------------------------\n",
    "def make_guide(K):\n",
    "    def guide(obs, x_pi, x_A, x_em):\n",
    "        C_em = x_em.shape[2]\n",
    "        # Hyperparametri stocastici per pi e A\n",
    "        alpha_pi = pyro.param(\"alpha_pi\", 0.5*torch.ones(K), constraint=dist.constraints.positive)\n",
    "        alpha_A  = pyro.param(\"alpha_A\", 0.5*torch.ones(K,K), constraint=dist.constraints.positive)\n",
    "        print(\"alpha_A_guide:\", alpha_A)\n",
    "\n",
    "        # Campioniamo pi e A da distribuzioni Dirichlet (stocastiche)\n",
    "        pi_base = pyro.sample(\"pi_base\", dist.Dirichlet(alpha_pi))\n",
    "        with pyro.plate(\"row\", K):\n",
    "            A_base = pyro.sample(\"A_base\", dist.Dirichlet(alpha_A).to_event(1))\n",
    "            print(\"A_base_guide:\", A_base.shape)\n",
    "\n",
    "        # Parametri beta_em stocastici (per emissioni Poisson)\n",
    "        beta_loc = pyro.param(\"beta_loc\", 0.01*torch.randn(K, C_em+1))\n",
    "        beta_scale = pyro.param(\"beta_scale\", 0.1*torch.ones(K, C_em+1), constraint=dist.constraints.positive)\n",
    "        pyro.sample(\"beta_em\", dist.Normal(beta_loc, beta_scale).to_event(2))\n",
    "        \n",
    "    return guide\n",
    "# ------------------------------------------------------------\n",
    "def fit_hmm(K, obs, x_pi, x_A, x_em, n_steps=1200, lr=0.01, seed=0, verbose=True):\n",
    "    pyro.set_rng_seed(seed)\n",
    "    pyro.clear_param_store()\n",
    "\n",
    "    elbo_losses = []\n",
    "\n",
    "    svi = SVI(\n",
    "        make_model(K),\n",
    "        make_guide(K),\n",
    "        Adam({\"lr\": lr}),\n",
    "        loss=TraceEnum_ELBO(max_plate_nesting=1)\n",
    "        )\n",
    "\n",
    "    for step in range(n_steps):\n",
    "            loss = svi.step(obs, x_pi, x_A, x_em)\n",
    "            if step % 50 == 0:\n",
    "                print(f\"K={K} | step {step:4d}  ELBO = {loss:,.0f}\")\n",
    "\n",
    "            elbo_losses.append(loss)\n",
    "            elbo = loss\n",
    "\n",
    "    print(f\"ELBO finale: {loss:.2f}\")\n",
    "\n",
    "    plt.figure(figsize=(8, 5))\n",
    "    plt.plot(elbo_losses, label=\"ELBO negativo\")\n",
    "    plt.xlabel(\"Iterazioni\")\n",
    "    plt.ylabel(\"ELBO negativo\")\n",
    "    plt.title(\"Andamento dell'ELBO negativo durante l'ottimizzazione\")\n",
    "    plt.grid(True)\n",
    "    plt.show()\n",
    "\n",
    "    return elbo, {k: v.detach().clone() for k, v in pyro.get_param_store().items()}\n"
   ]
