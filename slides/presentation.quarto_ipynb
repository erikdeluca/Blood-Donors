        "---\n",
        "title: Bayesian HMM-GLMs\n",
        "subtitle: Prediction of the propensity to donate in the blood donors in Trieste\n",
        "author:\n",
        "  - name: Erik De Luca\n",
        "    degrees: DEAMS\n",
        "    email: erik.deluca@studenti.units.it\n",
        "    affiliations:\n",
        "      - name: Dipartimento di Scienze Economiche, Aziendali, Matematiche e Statistiche \n",
        "        city: Trieste\n",
        "        state: Italia\n",
        "  - name: Tommaso Piscitelli\n",
        "    degrees: DIMG\n",
        "    email: tommaso.piscitelli@studenti.units.it\n",
        "    affiliations:\n",
